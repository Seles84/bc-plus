{
    "name": "bc-plus",
    "shortName": "BC+",
    "applicationName": "Bondage Club Plus",
    "description": "An extension for the web game Bondage Club, standalone or in tandem with BCX",
    "version": "0.4.5",
    "displayVersion": "0.4.5-DEV",
    "author": "Seles",
    "license": "MIT",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/Seles84/bc-plus"
    },
    "scripts": {
        "build": "node build.mjs",
        "build:dev": "node build.mjs --dev",
        "serve": "node build.mjs --serve",
        "typecheck": "tsc --noEmit",
        "smoke": "node build.mjs --dev && node scripts/smoke.mjs",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix"
    },
    "dependencies": {
        "bondage-club-mod-sdk": "^1.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "bc-stubs": "^131.0.0-Alpha.1",
        "esbuild": "^0.28.1",
        "eslint": "^10.8.1",
        "globals": "^17.9.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.66.0"
    }
}
